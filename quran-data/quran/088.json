      "qcf_page": 592
    },
    {
      "index": 7,
      "ayah_number": 7,
      "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﲉ ﲊ ﲋ ﲌ ﲍ ﲎ ﲏ",
      "qcf_page": 592
    },
    {
      "index": 8,
      "ayah_number": 8,
      "text": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
