      "export": true,
      "qcf": "ﱽ ﱾ ﱿ ﲀ ﲁ",
      "qcf_page": 592
    },
    {
      "index": 6,
      "ayah_number": 6,
      "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "start_ms": 0,
      "export": true,
