      "qcf": "ﲭ ﲮ ﲯ ﲰ ﲱ",
      "qcf_page": 452
    },
    {
      "index": 175,
      "ayah_number": 175,
      "text": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﲲ ﲳ ﲴ ﲵ",
      "qcf_page": 452
    },
    {
      "index": 176,
      "ayah_number": 176,
      "text": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﲶ ﲷ ﲸ",
      "qcf_page": 452
    },
    {
      "index": 177,
      "ayah_number": 177,
      "text": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﲹ ﲺ ﲻ ﲼ ﲽ ﲾ ﲿ",
      "qcf_page": 452
    },
    {
      "index": 178,
      "ayah_number": 178,
      "text": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﳀ ﳁ ﳂ ﳃ ﳄ",
      "qcf_page": 452
    },
    {
      "index": 179,
      "ayah_number": 179,
      "text": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ",
