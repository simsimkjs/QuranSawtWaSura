      "text": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﲞ ﲟ ﲠ ﲡ ﲢ ﲣ",
      "qcf_page": 452
    },
    {
      "index": 172,
      "ayah_number": 172,
      "text": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﲤ ﲥ ﲦ ﲧ",
      "qcf_page": 452
    },
    {
      "index": 173,
      "ayah_number": 173,
      "text": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﲨ ﲩ ﲪ ﲫ ﲬ",
      "qcf_page": 452
    },
    {
      "index": 174,
      "ayah_number": 174,
      "text": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
