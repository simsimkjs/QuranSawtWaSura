      "qcf": "ﱳ ﱴ ﱵ ﱶ",
      "qcf_page": 591
    },
    {
      "index": 12,
      "ayah_number": 12,
      "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
