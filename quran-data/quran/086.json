      "export": true,
      "qcf": "ﱬ ﱭ ﱮ ﱯ ﱰ ﱱ ﱲ",
      "qcf_page": 591
    },
    {
      "index": 11,
      "ayah_number": 11,
      "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
