      "export": true,
      "qcf": "ﱄ ﱅ ﱆ ﱇ ﱈ",
      "qcf_page": 591
    },
    {
      "index": 3,
      "ayah_number": 3,
      "text": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﱉ ﱊ ﱋ",
      "qcf_page": 591
    },
    {
      "index": 4,
      "ayah_number": 4,
      "text": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﱌ ﱍ ﱎ ﱏ ﱐ ﱑ ﱒ",
      "qcf_page": 591
    },
    {
      "index": 5,
      "ayah_number": 5,
      "text": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﱓ ﱔ ﱕ ﱖ ﱗ",
      "qcf_page": 591
    },
    {
      "index": 6,
      "ayah_number": 6,
      "text": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﱘ ﱙ ﱚ ﱛ ﱜ",
      "qcf_page": 591
    },
    {
      "index": 7,
      "ayah_number": 7,
      "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﱝ ﱞ ﱟ ﱠ ﱡ ﱢ",
      "qcf_page": 591
    },
    {
      "index": 8,
      "ayah_number": 8,
      "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﱣ ﱤ ﱥ ﱦ ﱧ",
      "qcf_page": 591
    },
    {
      "index": 9,
      "ayah_number": 9,
      "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "start_ms": 0,
      "export": true,
      "qcf": "ﱨ ﱩ ﱪ ﱫ",
      "qcf_page": 591
    },
    {
      "index": 10,
      "ayah_number": 10,
      "text": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
